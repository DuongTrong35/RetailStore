@{
    ViewData["Title"] = "Phiếu nhập";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}
@model IEnumerable<RetailStore.Models.ImportReceipt>

    @{
    ViewData["Title"] = "Quản lý nhập kho";
    }

    <div class="container-fluid">
        <h1 class="h3 mb-4 text-gray-800">Quản lý nhập kho</h1>

        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Bộ lọc tìm kiếm</h6>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="searchString">Từ khóa</label>
                            <div class="input-group">
                                
                                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                                       class="form-control" placeholder="Mã phiếu, NCC, Nhân viên..." />
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label for="fromDate">Từ ngày</label>
                            <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label for="toDate">Đến ngày</label>
                            <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control" />
                        </div>

                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <div class="btn-group w-100" role="group">
                                <button type="submit" class="btn btn-primary" title="Tìm kiếm">
                                    <i class="fas fa-search"></i> Tìm
                                </button>

                                <a asp-action="Index" class="btn btn-secondary" title="Làm mới bộ lọc">
                                    <i class="fas fa-sync-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="mb-3 text-right">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus"></i> Tạo phiếu nhập mới
            </a>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th width="5%">#ID</th>
                                <th>Nhà cung cấp</th>
                                <th>Người nhập</th>
                                <th>Ngày nhập</th>
                                <th class="text-right">Tổng tiền</th>
                                <th width="10%" class="text-center">Tác vụ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                            <tr>
                                <td>@item.ImportId</td>
                                <td><span class="font-weight-bold text-primary">@item.Supplier?.Name</span></td>
                                <td>@item.User?.FullName</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-right font-weight-bold text-danger">
                                    @item.TotalAmount.ToString("#,##0") đ
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.ImportId" class="btn btn-info btn-circle btn-sm" title="Xem chi tiết">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                </td>
                            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">Không tìm thấy phiếu nhập nào</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
