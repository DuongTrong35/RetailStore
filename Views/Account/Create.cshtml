@{
    ViewData["Title"] = "Thêm tài khoản mới";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

@model RetailStore.Models.User

<div>
    <div class="bg-white border-bottom p-3 mb-3">
        <h2 class="mb-0">Thêm tài khoản mới</h2>
    </div>

    <div class="px-3">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-8">
                    <div class="bg-white p-4 rounded-3 shadow-sm">

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Vai trò (Role)</label>
                            <input asp-for="Role" class="form-control" />
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Tạo mới</button>

                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
