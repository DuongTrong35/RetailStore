@{
    ViewData["Title"] = "Tài khoản";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

@model IEnumerable<RetailStore.Models.User>

<div>
    <div class="bg-white border-bottom p-3 mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="mb-0">Quản lý tài khoản</h2>
            </div>
            <div class="col-auto">
                <form asp-action="Index" method="get" class="d-flex justify-content-end">
                    <div class="input-group" style="width: 300px;">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Nhập tên, username... " onfocus="this.value=''">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="mb-3 px-3 d-flex justify-content-between flex-wrap align-items-center gap-2">

        <div class="d-flex align-items-center">
            <a class="btn btn-outline-primary me-2" asp-controller="Account" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Thêm tài khoản
            </a>

            <button type="submit" class="btn btn-outline-danger" form="deleteForm"
                    onclick="return confirm('Bạn có chắc chắn muốn xóa các tài khoản đã chọn?');">
                <i class="bi bi-trash"></i> Xóa mục đã chọn
            </button>

            <button type="button" class="btn btn-outline-success ms-2"
                    title="Tải lại dữ liệu"
                    style="aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; width: 38px; height: 38px"
                    onclick="document.querySelector('.HomeLeft li.active').click()">
                <i class="bi bi-arrow-repeat" style="font-size: 1.2rem;"></i>
            </button>
        </div>

        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2 bg-light p-2 rounded border m-0" style="height: 38px">
            <input type="hidden" name="searchString" value="@ViewData["CurrentFilter"]" />

            <select name="selectedRole" class="form-select form-select-sm border-secondary" style="width: auto; max-width: 150px;">
                <option value="">-- Tất cả vai trò --</option>
                @if (ViewBag.Roles != null)
                {
                    foreach (var role in ViewBag.Roles)
                    {
                        var isSelected = (string)ViewData["SelectedRole"] == role ? "selected" : "";
                        @Html.Raw($"<option value='{role}' {isSelected}>{role}</option>")
                    }
                }
            </select>

            <div class="vr mx-1"></div> <div class="d-flex align-items-center gap-1">
                <span class="small fw-bold text-muted">Từ:</span>
                <input type="date" name="fromDate" value="@ViewData["FromDate"]"
                       class="form-control form-control-sm border-secondary" style="width: 130px;">
            </div>

            <div class="d-flex align-items-center gap-1">
                <span class="small fw-bold text-muted">Đến:</span>
                <input type="date" name="toDate" value="@ViewData["ToDate"]"
                       class="form-control form-control-sm border-secondary" style="width: 130px;"
                       max="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>

            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel-fill"></i> Lọc
            </button>
        </form>
    </div>

    <form asp-action="DeleteSelected" method="post" id="deleteForm">
        @Html.AntiForgeryToken()
        <div class="px-3">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox" class="form-check-input" id="selectAll"></th>
                            <th>Tên đăng nhập</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tạo</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input row-checkbox"
                                               name="selectedIds" value="@item.UserId">
                                    </td>
                                    <td>@item.Username</td>
                                    <td>@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Role</td>
                                    <td>@item.CreatedAt.Value.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.UserId">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<style>
    .nav-link {
        border-left: 3px solid transparent;
    }

        .nav-link.active {
            border-left-color: #0d6efd;
        }

        .nav-link:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }

    .table th {
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        console.log("Account Index page loaded.");
        document.addEventListener('DOMContentLoaded', function () {
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');

            selectAllCheckbox.addEventListener('change', function () {
                rowCheckboxes.forEach(checkbox => {
                    checkbox.checked = selectAllCheckbox.checked;
                });
            });
        });
    </script>
}