@model RetailStore.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa sản phẩm</h4>
                </div>
                <div class="card-body">
                    <p class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác.
                    </p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-end">Tên sản phẩm:</dt>
                        <dd class="col-sm-8 fw-bold fs-5">@Model.ProductName</dd>

                        <dt class="col-sm-4 text-end">Mã vạch:</dt>
                        <dd class="col-sm-8">@(Model.Barcode ?? "Không có")</dd>

                        <dt class="col-sm-4 text-end">Giá bán:</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@Model.Price.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-4 text-end">Danh mục:</dt>
                        <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "-")</dd>

                        <dt class="col-sm-4 text-end">Nhà cung cấp:</dt>
                        <dd class="col-sm-8">@(Model.Supplier?.Name ?? "-")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ProductId" />
                        <button type="submit" class="btn btn-danger fw-bold px-4">
                            <i class="fas fa-trash-alt"></i> Xóa ngay
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>
            </div>
        </div>
    </div>
</div>