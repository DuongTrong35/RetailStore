@model RetailStore.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container py-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="fas fa-plus"></i> Thêm sản phẩm mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-bold"></label>
                            <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUpload" class="form-label fw-bold">Hình ảnh sản phẩm</label>
                            <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ImageUpload" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Barcode" class="form-label fw-bold"></label>
                                <input asp-for="Barcode" class="form-control" placeholder="Quét mã vạch..." />
                                <span asp-validation-for="Barcode" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Unit" class="form-label fw-bold"></label>
                                <input asp-for="Unit" class="form-control" placeholder="Ví dụ: Cái, Hộp..." />
                                <span asp-validation-for="Unit" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold text-success"></label>
                            <div class="input-group">
                                <input asp-for="Price" class="form-control" type="number" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4 bg-light p-3 rounded">
                        <h5 class="mb-3 text-secondary">Phân loại</h5>
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SupplierId" class="form-label fw-bold">Nhà cung cấp</label>
                            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId">
                                <option value="">-- Chọn nhà cung cấp --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mt-4 border-top pt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="fas fa-save"></i> Lưu lại
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}