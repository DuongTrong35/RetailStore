@model IEnumerable<RetailStore.Models.Product>

    @{ ViewData["Title"] = "Quản lý sản phẩm"; }

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary fw-bold"><i class="fas fa-box"></i> Danh sách sản phẩm</h2>
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus-circle"></i> Thêm mới sản phẩm
            </a>
        </div>

        <div class="card shadow-sm mb-4 bg-light">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tìm kiếm</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Nhập tên sản phẩm hoặc mã vạch..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Danh mục</label>
                        <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">-- Tất cả danh mục --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Nhà cung cấp</label>
                        <select name="supplierId" class="form-select" asp-items="ViewBag.SupplierId">
                            <option value="">-- Tất cả NCC --</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            <i class="fas fa-filter"></i> Lọc dữ liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th style="width: 80px;">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Mã vạch</th>
                            <th>Giá bán</th>
                            <th>Đơn vị</th>
                            <th>Danh mục</th>
                            <th>Nhà cung cấp</th>
                            <th class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted fst-italic">
                                <i class="fas fa-search-minus fa-2x mb-2"></i><br />
                                Không tìm thấy sản phẩm nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            <td class="text-center">
                                @if(!string.IsNullOrEmpty(item.ImageUrl)) {
                                <img src="@item.ImageUrl" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" alt="Product Img" />
                                } else {
                                <i class="fas fa-image text-secondary fa-2x"></i>
                                }
                            </td>
                            <td class="fw-bold text-primary">@item.ProductName</td>
                            <td><span class="badge bg-secondary">@item.Barcode</span></td>
                            <td class="text-end text-danger fw-bold">@item.Price.ToString("N0") ₫</td>
                            <td>@item.Unit</td>
                            <td>@(item.Category?.CategoryName ?? "-")</td>
                            <td>@(item.Supplier?.Name ?? "-")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-warning" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
