@*
View: Reset Password
*@
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu</title>

    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="Container">

        <!-- Hình trái -->
        <div class="PictureLeft">
            <img src="~/Icons/team7na.png" alt="" />
        </div>

        <!-- Form reset mật khẩu -->
        <div class="flex items-center justify-center h-screen">
            <div class="bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 p-[8px] rounded-xl shadow-lg w-[500px]">
                <div class="bg-white rounded-xl p-8 flex flex-col items-center">

                    <div class="logo_container mb-4">
                        <img src="~/Icons/logodn.png" alt="Logo" class="w-16 h-16 object-contain">
                    </div>

                    <div class="title_container text-center mb-6">
                        <p class="text-2xl font-bold text-gray-800">Đặt lại mật khẩu</p>
                        <span class="text-sm text-gray-500">
                            Nhập mật khẩu mới cho tài khoản của bạn
                        </span>
                    </div>

                    <form asp-action="ResetPassword"
                          asp-controller="Login"
                          method="post"
                          class="w-full flex flex-col gap-4">

                        <!-- TOKEN -->
                        <input type="hidden" name="token" value="@ViewBag.Token" />

                        <!-- Mật khẩu mới -->
                        <div class="flex flex-col">
                            <label class="text-sm font-medium text-gray-700 mb-1">
                                Mật khẩu mới
                            </label>
                            <div class="relative flex items-center">
                                <i class="fa-solid fa-key absolute left-3 text-gray-500"></i>
                                <input type="password"
                                       name="newPassword"
                                       placeholder="Nhập mật khẩu mới"
                                       required
                                       class="w-full border border-gray-300 rounded-md py-2 pl-10 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="flex flex-col">
                            <label class="text-sm font-medium text-gray-700 mb-1">
                                Xác nhận mật khẩu
                            </label>
                            <div class="relative flex items-center">
                                <i class="fa-solid fa-lock absolute left-3 text-gray-500"></i>
                                <input type="password"
                                       name="confirmPassword"
                                       placeholder="Nhập lại mật khẩu"
                                       required
                                       class="w-full border border-gray-300 rounded-md py-2 pl-10 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="w-full bg-[#377dff] hover:bg-blue-600 text-white font-semibold py-2 rounded-md transition">
                            Xác nhận đổi mật khẩu
                        </button>

                        <!-- Back -->
                        <a asp-action="Index" asp-controller="Login"
                           class="text-blue-600 text-sm text-center hover:underline">
                            Quay lại đăng nhập
                        </a>

                    </form>

                </div>
            </div>
        </div>

        <!-- Hình phải -->
        <div class="PictureRight">
            <img src="~/Icons/team7bo.png" alt="" />
        </div>

    </div>
</body>
</html>
