@*
View: Forgot Password
*@
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="Container">

        ```
        <!-- Hình trái -->
        <div class="PictureLeft">
            <img src="~/Icons/team7na.png" alt="" />
        </div>

        <!-- Form quên mật khẩu -->
        <div class="flex items-center justify-center h-screen">
            <div class="bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 p-[8px] rounded-xl shadow-lg w-[500px]">
                <div class="bg-white rounded-xl p-8 flex flex-col items-center">

                    <div class="logo_container mb-4">
                        <img src="~/Icons/logodn.png" alt="Logo" class="w-16 h-16 object-contain">
                    </div>

                    <div class="title_container text-center mb-6">
                        <p class="text-2xl font-bold text-gray-800">Quên mật khẩu</p>
                        <span class="text-sm text-gray-500">
                            Nhập thông tin để nhận link đặt lại mật khẩu qua email
                        </span>
                    </div>

                    <form asp-action="ForgotPassword" asp-controller="Login" method="post" class="w-full flex flex-col gap-4">

                        <!-- Username -->
                        <div class="flex flex-col">
                            <label class="text-sm font-medium text-gray-700 mb-1">Username</label>
                            <div class="relative flex items-center">
                                <i class="fa-solid fa-user absolute left-3 text-gray-500"></i>
                                <input type="text"
                                       name="Username"
                                       placeholder="Nhập username"
                                       required
                                       class="w-full border border-gray-300 rounded-md py-2 pl-10 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="flex flex-col">
                            <label class="text-sm font-medium text-gray-700 mb-1">Email</label>
                            <div class="relative flex items-center">
                                <i class="fa-solid fa-envelope absolute left-3 text-gray-500"></i>
                                <input type="email"
                                       name="Email"
                                       placeholder="Nhập email đã đăng ký"
                                       required
                                       class="w-full border border-gray-300 rounded-md py-2 pl-10 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="w-full bg-[#377dff] hover:bg-blue-600 text-white font-semibold py-2 rounded-md transition">
                            Gửi link đặt lại mật khẩu
                        </button>

                        <!-- Back to login -->
                        <a asp-action="Index" asp-controller="Login"
                           class="text-blue-600 text-sm text-center hover:underline">
                            Quay lại đăng nhập
                        </a>

                    </form>
                </div>
            </div>
        </div>

        <!-- Hình phải -->
        <div class="PictureRight">
            <img src="~/Icons/team7bo.png" alt="" />
        </div>

    </div>
</body>
</html>
