@{
    ViewData["Title"] = "Ưu đãi";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

@model IEnumerable<RetailStore.Models.Promotion>

<div>
    <div class="bg-white border-bottom p-3 mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="mb-0">Quản lý Ưu Đãi</h2>
            </div>
            <div class="col-auto">
                <form asp-action="Index" method="get" class="d-flex justify-content-end">
                    <div class="input-group" style="width: 360px;">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm mã hoặc mô tả" onfocus="this.value=''">
                        <select name="status" class="form-select" style="max-width: 150px;">
                            <option value="">-- Trạng thái --</option>
                            <option value="active" selected="@(string.Equals((string?)ViewData["StatusFilter"], "active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Đang hoạt động</option>
                            <option value="inactive" selected="@(string.Equals((string?)ViewData["StatusFilter"], "inactive", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Không hoạt động</option>
                        </select>
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <form asp-action="DeleteSelected" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3 d-flex align-items-center px-3">
            <a class="btn btn-outline-primary me-2" asp-controller="Promotion" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Thêm ưu đãi
            </a>

            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Bạn có chắc chắn muốn xóa các ưu đãi đã chọn?');">
                <i class="bi bi-trash"></i> Xóa mục đã chọn
            </button>
        </div>

        <div class="px-3">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox" class="form-check-input" id="selectAll"></th>
                            <th>Mã</th>
                            <th>Mô tả</th>
                            <th>Loại</th>
                            <th>Giá trị</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                            <th>Đơn tối thiểu</th>
                            <th>Giới hạn/Đã dùng</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input row-checkbox"
                                               name="selectedIds" value="@item.PromoId">
                                    </td>
                                    <td>@item.PromoCode</td>
                                    <td>@item.Description</td>
                                    <td>@(item.DiscountType == "percent" ? "Phần trăm" : "Cố định")</td>
                                    <td>
                                        @if (item.DiscountType == "percent")
                                        {
                                            @($"{item.DiscountValue:0.##}%")
                                        }
                                        else
                                        {
                                            @string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", item.DiscountValue)
                                        }
                                    </td>
                                    <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.MinOrderAmount.HasValue ? item.MinOrderAmount.Value.ToString("N0") : "0")</td>
                                    <td>@(item.UsageLimit ?? 0)/@(item.UsedCount ?? 0)</td>
                                    <td>
                                        @if (item.Status == "active")
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngưng</span>
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.PromoId">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<style>
    .nav-link {
        border-left: 3px solid transparent;
    }

        .nav-link.active {
            border-left-color: #0d6efd;
        }

        .nav-link:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }

    .table th {
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');

            selectAllCheckbox.addEventListener('change', function () {
                rowCheckboxes.forEach(checkbox => {
                    checkbox.checked = selectAllCheckbox.checked;
                });
            });
        });
    </script>
}