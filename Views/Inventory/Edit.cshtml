@model RetailStore.Models.Inventory
@{
    ViewData["Title"] = "Chỉnh sửa tồn kho";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chỉnh sửa tồn kho #@Model.InventoryId</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden ID -->
                <input type="hidden" asp-for="InventoryId" />

                <!-- Product -->
                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label">Mã sản phẩm</label>
                    <input asp-for="ProductId"
                           class="form-control"
                           readonly />
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>

                <!-- Quantity -->
                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Số lượng tồn</label>
                    <input asp-for="Quantity"
                           type="number"
                           min="0"
                           class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <!-- UpdatedAt (readonly) -->
                <div class="mb-3">
                    <label class="form-label">Cập nhật lần cuối</label>
                    <input type="text"
                           class="form-control"
                           value="@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm"))"
                           readonly />
                </div>

                <div class="border-top pt-4 mt-4">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4">
                            Lưu thay đổi
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
