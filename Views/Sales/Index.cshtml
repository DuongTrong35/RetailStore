    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const products = document.querySelectorAll('.product-card');
            const perPage = 12; // số sản phẩm hiển thị mỗi lần
            let currentPage = 1;
            const totalPages = Math.ceil(products.length / perPage);

            function showPage(page) {
                products.forEach((p, i) => {
                    const start = (page - 1) * perPage;
                    const end = start + perPage;
                    p.style.display = (i >= start && i < end) ? 'block' : 'none';
                });
            }

            document.querySelector('.productnext').addEventListener('click', () => {
                currentPage++;
                if (currentPage > totalPages) currentPage = 1;
                showPage(currentPage);
            });

            document.querySelector('.productprev').addEventListener('click', () => {
                currentPage--;
                if (currentPage < 1) currentPage = totalPages;
                showPage(currentPage);
            });

            // Hiển thị 2 sản phẩm đầu tiên
            showPage(currentPage);
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* =========================================================================
                1. LẤY CÁC DOM CHÍNH
            ========================================================================= */
            const tableBody = document.querySelector(".productsell tbody");
            const lblTotalQty = document.querySelector(".qualityproduct span");
            const lblTotalMoney = document.querySelector(".sumproduct span");
            const lblPoints = document.querySelector(".homerightcustomerpoint span");

            let totalQty = Number(lblTotalQty.textContent) || 0;
            let totalMoney = Number(lblTotalMoney.textContent) || 0;
            let totalPoints = Number(lblPoints.textContent) || 0;

            /* =========================================================================
                2. CẬP NHẬT TỔNG TIỀN / ĐIỂM TÍCH LŨY
            ========================================================================= */
            function updateTotalMoney(type, amount) {
                if (type === "add") totalMoney += amount;
                else totalMoney -= amount;
                if (totalMoney < 0) totalMoney = 0;

                lblTotalMoney.textContent = totalMoney;
                updatePoints();
            }

            function updatePoints() {
                totalPoints = Math.floor(totalMoney / 10000);
                lblPoints.textContent = totalPoints;
            }

            /* =========================================================================
                3. CẬP NHẬT THÀNH TIỀN HÀNG
            ========================================================================= */
            function updateRowTotal(row, price) {
                const qty = Number(row.querySelector("input").value) || 1;
                const money = qty * price;
                row.querySelector(".sum1bill").textContent = money.toLocaleString();
                updatePoints();
            }

            /* =========================================================================
                4. GẮN SỰ KIỆN TĂNG GIẢM
            ========================================================================= */
            function attachQtyEvents(row, price) {
                let input = row.querySelector("input");
                let btnDec = row.querySelector(".decrease");
                let btnInc = row.querySelector(".increase");

                btnDec.onclick = () => {
                    let qty = Number(input.value);
                    if (qty > 1) {
                        input.value = qty - 1;
                        totalQty--;
                        lblTotalQty.textContent = totalQty;
                        updateRowTotal(row, price);
                        updateTotalMoney("minus", price);
                    }
                };

                btnInc.onclick = () => {
                    input.value = Number(input.value) + 1;
                    totalQty++;
                    lblTotalQty.textContent = totalQty;
                    updateRowTotal(row, price);
                    updateTotalMoney("add", price);
                };

                input.oninput = () => {
                    input.value = input.value.replace(/[^0-9]/g, '') || "1";
                    updateRowTotal(row, price);
                };
            }

            /* =========================================================================
                5. XÓA SẢN PHẨM
            ========================================================================= */
            function attachDeleteEvent(row) {
                row.querySelector(".delete-btn").onclick = () => {
                    if (!confirm("Xóa sản phẩm?")) return;

                    const qty = Number(row.querySelector("input").value) || 0;
                    const money = Number(row.querySelector(".sum1bill").textContent.replace(/[^\d]/g, "")) || 0;

                    totalQty -= qty;
                    lblTotalQty.textContent = totalQty;

                    updateTotalMoney("minus", money);

                    row.remove();
                    Array.from(tableBody.rows).forEach((r, i) => r.cells[0].textContent = i + 1);
                };
            }

            /* =========================================================================
                6. XỬ LÝ BẤM SẢN PHẨM TRONG DANH MỤC
            ========================================================================= */
            document.querySelectorAll(".product-card").forEach(card => {
                card.onclick = () => {
                    addProductToTable({
                        id: card.dataset.productId,
                        name: card.dataset.name,
                        price: Number(card.dataset.price),
                        unit: card.dataset.unit || ""
                    });
                };
            });

            /* =========================================================================
                7. HÀM THÊM SẢN PHẨM
            ========================================================================= */
            function addProductToTable(p) {

                const existed = Array.from(tableBody.rows).find(row => row.cells[1].textContent === p.id);

                // --- TĂNG SỐ LƯỢNG ---
                if (existed) {
                    let input = existed.querySelector("input");
                    input.value = Number(input.value) + 1;
                    totalQty++;
                    lblTotalQty.textContent = totalQty;
                    updateRowTotal(existed, p.price);
                    updateTotalMoney("add", p.price);
                    return;
                }

                // --- THÊM DÒNG MỚI ---
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${tableBody.rows.length + 1}</td>
                    <td class="productid">${p.id}</td>
                    <td class="productname">${p.name}</td>
                    <td>${p.unit}</td>
                    <td>
                        <div class="qty-control">
                            <button class="decrease">-</button>
                            <input type="text" value="1" class="producqty" />
                            <button class="increase">+</button>
                        </div>
                    </td>
                    <td class="productprice">${p.price.toLocaleString()}</td>
                    <td class="sum1bill producttotal">${p.price.toLocaleString()}</td>
                    <td><button class="delete-btn"><i class="fa-solid fa-trash-can"></i></button></td>
                `;

                tableBody.appendChild(row);

                totalQty++;
                lblTotalQty.textContent = totalQty;

                updateTotalMoney("add", p.price);

                attachQtyEvents(row, p.price);
                attachDeleteEvent(row);
            }

            /* =========================================================================
                8. SEARCH SẢN PHẨM
            ========================================================================= */
            const searchInput = document.getElementById("searchInput");
            const searchResults = document.getElementById("searchResults");
        const imageBaseUrl = '@Url.Content("~/Images/products")';
                    searchInput.oninput = () => {
                let text = searchInput.value.trim();
                if (text.length < 1) return searchResults.style.display = "none";

                fetch(`/Sales/Search?keyword=${encodeURIComponent(text)}`)
                    .then(res => res.json())
                    .then(list => {
                        searchResults.innerHTML = "";
                        if (!list.length) return searchResults.style.display = "none";

                        list.forEach(p => {
                            let div = document.createElement("div");
                            div.className = "searchitem";
                            div.dataset.productId = p.productId;
                            div.dataset.name = p.productName;
                            div.dataset.price = p.price;
                            div.dataset.unit = p.unit;

                            div.innerHTML = `
                                <div class="searchitemleft">
        <img src="${p.imageUrl}">
                                </div>
                                <div class="searchitemcenter">
                                    <p>Mã: ${p.productId}</p>
                                    <p>${p.productName}</p>
                                </div>
                                <div class="searchitemright">
                                    <p>${p.price.toLocaleString()} đ</p>
                                    <p>SL: ${p.quantity}</p>
                                </div>
                            `;
        div.onclick = () => {
            addProductToTable({
                id: p.productId,
                name: p.productName,
                price: Number(p.price),
                unit: p.unit
            });

            searchInput.value = "";
            searchResults.style.display = "none";
        };


                            searchResults.appendChild(div);
                        });

                        searchResults.style.display = "block";
                    });
            };

            /* =========================================================================
                9. MÃ GIẢM GIÁ
            ========================================================================= */
                   document.getElementById("btnCheckPromo")?.addEventListener("click", async function () {
            const code = document.getElementById("promocustomer").value.trim();
            if (!code) return showToast("Nhập mã giảm giá!", "crimson");

            const res = await fetch(`/Sales/searchmagiam?keyword=${code}`);
            if (!res.ok) return showToast("Mã không tồn tại!", "crimson");

            const promo = await res.json();

            let now = new Date();
            let start = new Date(promo.startDate);
            let end = new Date(promo.endDate);

            if (now < start || now > end)
                return showToast("Mã giảm giá hết hạn!", "crimson");

            if (promo.status.toLowerCase() !== "active")
                return showToast("Mã không hoạt động!", "crimson");

            if (totalMoney < promo.minOrderAmount)
                return showToast(`Đơn phải đạt ${promo.minOrderAmount.toLocaleString()}đ`, "crimson");

            // TÍNH GIẢM
            let discount = promo.discountType === "percent"
                ? totalMoney * promo.discountValue / 100
                : promo.discountValue;

            totalMoney -= discount;
            lblTotalMoney.textContent = totalMoney;
            //updatePoints();

            // LƯU VÀO INPUT HIDDEN (QUAN TRỌNG)
            document.getElementById("promo_id").value = promo.promoId;
            document.getElementById("promo_discount").value = discount;

            document.getElementById("promocustomer").value = "Áp dụng thành công";
            showToast("Áp dụng mã thành công!", "green");

            await fetch(`/Sales/UpdatePromoUsage?keyword=${code}`, { method: "POST" });
        });


            function showToast(msg, color = "black") {
                const t = document.getElementById("toast");
                t.textContent = msg;
                t.style.background = color;
                t.style.opacity = 1;
                setTimeout(() => t.style.opacity = 0, 2000);
            }

            /* =========================================================================
                10. TIỀN KHÁCH TRẢ – TIỀN THỐI
            ========================================================================= */
            document.getElementById("moneycustommerpay")?.addEventListener("input", function () {
                let raw = this.value.replace(/,/g, "");
                let pay = Number(raw) || 0;
                let change = pay - totalMoney;
                document.getElementById("customermoney").textContent = change;
            });

            /* =========================================================================
                11. SPLITTER KÉO LÊN XUỐNG
            ========================================================================= */
            const splitter = document.getElementById("splitter");
            const topPane = document.querySelector(".productsell");
            const container = document.querySelector(".maincontainer");
            let dragging = false;

            splitter.onmousedown = () => {
                dragging = true;
                document.body.style.cursor = "row-resize";
            };

            document.onmousemove = e => {
                if (!dragging) return;
                const rect = container.getBoundingClientRect();
                let y = e.clientY - rect.top;
                if (y > 100 && y < rect.height - 200)
                    topPane.style.height = y + "px";
            };

            document.onmouseup = () => {
                dragging = false;
                document.body.style.cursor = "default";
            };

        });
    </script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $("#btncheckphone").click(function () {

            var phone = $("#custommerphone").val(); // input số điện thoại

            $.ajax({
                url: '/Sales/CheckCustomerPhone',
                type: 'GET',
                data: { phone: phone },

                success: function (res) {
                    if (res.success) {
                        // ✔ Gán ID khách hàng vào span customermoney
                        $("#customerid").text(res.customerId);
                    } else {
                        $("#customerid").text("0"); // hoặc "Không có"
                        alert("Không tìm thấy khách hàng");
                    }
                },

                error: function () {
                    alert("Lỗi kết nối server");
                }
            });
        });
    </script>



    <script>
