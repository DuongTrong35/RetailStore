            });

            //  LẤY CÁC GIÁ TRỊ KHÁC
            // const data = {
            //     UserId: @nvid+"",
            //     customerId: parseInt(document.getElementById("customerid").innerText),
            //     promoCode: document.getElementById("promocustomer").value,
            //     totalAmount: parseFloat(document.querySelector(".sumproduct span").innerText),
            //     discountAmount: 0, nếu bạn có khuyến mãi thì thay đổi ở đây
            //     moneyPay: parseFloat(document.getElementById("moneycustommerpay").value),
            //     moneyReturn: parseFloat(document.getElementById("customermoney").innerText),
            //     items: items
            // };
                    const data = {
