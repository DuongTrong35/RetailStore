        console.log(`--- DÒNG check ---`);
        console.log("product-id:", idCell?.innerText);
        console.log("qty:", qtyCell?.innerText);
        console.log("price:", priceCell?.innerText);
                items.push({
                    productId: parseInt(row.querySelector(".productid").innerText),
                    quantity: parseInt(row.querySelector(".producqty").value),
                    price: parseFloat(row.querySelector(".producttotal").innerText)
