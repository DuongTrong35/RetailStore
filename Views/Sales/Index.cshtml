        .then(result => {
            //alert("Thanh toán thành công! Mã đơn: " + result.orderId);
                 if (confirm("Thanh toán thành công!\nMã đơn: " + result.orderId + "\nQuay về trang bán hàng?")) {
            window.location.href = "/Sales/Index";
        }
        })
