@model IEnumerable<RetailStore.Models.Supplier>

@{
    ViewData["Title"] = "Nhà cung cấp";

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<div>
    <div class="bg-white border-bottom p-3 mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="mb-0">Quản lý nhà cung cấp</h2>
            </div>
            <div class="col-auto">
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">

                    <div class="input-group" style="width: 300px;">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                               class="form-control" placeholder="Nhập tên, SĐT, email..."
                               onfocus="this.value=''">
                        <button type="submit" class="btn btn-outline-secondary" title="Tìm kiếm">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <a asp-action="Index" class="btn btn-outline-secondary" title="Tải lại danh sách">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>

                </form>
            </div>
        </div>
    </div>

    <form asp-action="DeleteSelected" method="post" id="mainForm">
        @Html.AntiForgeryToken()

        <div class="mb-3 d-flex align-items-center px-3">
            <a class="btn btn-outline-primary me-2" asp-controller="Supplier" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Thêm nhà cung cấp
            </a>

            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Bạn có chắc chắn muốn xóa các nhà cung cấp đã chọn?');">
                <i class="bi bi-trash"></i> Xóa mục đã chọn
            </button>
        </div>

        <div class="px-3">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox" class="form-check-input" id="selectAll"></th>
                            <th>Tên nhà cung cấp</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Địa chỉ</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input row-checkbox"
                                               name="selectedIds" value="@item.SupplierId">
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Phone</td>
                                    <td>@item.Email</td>
                                    <td>@item.Address</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.SupplierId">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@item.SupplierId"
                                                    data-name="@item.Name">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không tìm thấy nhà cung cấp nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa nhà cung cấp: <strong id="supplierNameDelete"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SupplierId" id="supplierIdDelete" />
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-link {
        border-left: 3px solid transparent;
    }

        .nav-link.active {
            border-left-color: #0d6efd;
        }

        .nav-link:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }

    .table th {
        font-weight: 600;
        white-space: nowrap;
    }

        .table th a {
            text-decoration: none;
            color: inherit;
        }

            .table th a:hover {
                text-decoration: underline;
            }

    .table td {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Logic chọn tất cả checkbox (của bạn)
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');
            if(selectAllCheckbox){
                selectAllCheckbox.addEventListener('change', function () {
                    rowCheckboxes.forEach(checkbox => {
                        checkbox.checked = selectAllCheckbox.checked;
                    });
                });
            }

            // LOGIC MỚI: Xử lý khi bật Modal Xóa
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                // Nút đã kích hoạt modal
                var button = event.relatedTarget;
                // Lấy thông tin từ data-attribute của nút
                var id = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');

                // Cập nhật thông tin vào trong Modal
                var modalTitle = deleteModal.querySelector('.modal-title');
                var nameInput = deleteModal.querySelector('#supplierNameDelete');
                var idInput = deleteModal.querySelector('#supplierIdDelete');

                nameInput.textContent = name;
                idInput.value = id;
            });
        });
    </script>
}